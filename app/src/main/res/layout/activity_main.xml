<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101216"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <!-- App Logo & Branding Header -->
        <ImageView
            android:id="@+id/imgLogo"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_marginTop="16dp"
            android:src="@drawable/ic_launcher"
            android:contentDescription="Willy LibTool Logo" />

        <TextView
            android:id="@+id/txtTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Willy LibTool"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="IL2CPP Native Reverse Engineering &amp; Overlay"
            android:textColor="#A0A5B5"
            android:textSize="13sp" />

        <!-- Status Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="#1A1D24"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SYSTEM STATUS"
                android:textColor="#00E5FF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="12dp"
                android:background="#2E3440" />

            <!-- Overlay Permission Status -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Floating Window Permission:"
                    android:textColor="#D8DEE9"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/txtOverlayStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Checking..."
                    android:textColor="#FF5252"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Storage Permission Status -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Storage Access:"
                    android:textColor="#D8DEE9"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/txtStorageStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Checking..."
                    android:textColor="#FF5252"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Overlay Service Status -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Floating Menu Service:"
                    android:textColor="#D8DEE9"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/txtServiceStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="STOPPED"
                    android:textColor="#FF5252"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Device Compatibility Status -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Device Support:"
                    android:textColor="#D8DEE9"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/txtDeviceMode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NON-ROOTED (FULL)"
                    android:textColor="#00E676"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Actions -->
        <Button
            android:id="@+id/btnGrantOverlay"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:background="#2E3440"
            android:text="GRANT FLOATING PERMISSION"
            android:textColor="#00E5FF"
            android:textStyle="bold"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnToggleService"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="12dp"
            android:background="#D5011D"
            android:text="START WILLY LIBTOOL"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnLaunchMLBB"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:background="#1E232E"
            android:text="LAUNCH MOBILE LEGENDS"
            android:textColor="#ECEFF4"
            android:textSize="14sp" />

        <!-- Shizuku Tools Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="#1A1D24"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SHIZUKU TOOLS (NO ROOT)"
                android:textColor="#00E5FF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="12dp"
                android:background="#2E3440" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Shizuku Status:"
                    android:textColor="#D8DEE9"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/txtShizukuStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Checking..."
                    android:textColor="#FFAB00"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Display Refresh Rate:"
                    android:textColor="#D8DEE9"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/txtRefreshInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-"
                    android:textColor="#A0A5B5"
                    android:textSize="13sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnShizukuGrant"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:background="#2E3440"
                android:text="GRANT SHIZUKU PERMISSION"
                android:textColor="#00E5FF"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnBackup"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="#1E232E"
                android:text="BACKUP MLBB SETTINGS"
                android:textColor="#ECEFF4" />

            <Button
                android:id="@+id/btnRestore"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="#1E232E"
                android:text="RESTORE FROM BACKUP"
                android:textColor="#ECEFF4" />

            <Button
                android:id="@+id/btnCleanCache"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="#1E232E"
                android:text="CLEAN MLBB CACHE"
                android:textColor="#ECEFF4" />

            <Button
                android:id="@+id/btnRefreshRate"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="#1E232E"
                android:text="DISPLAY: FORCE MAX REFRESH RATE (120/144HZ)"
                android:textColor="#ECEFF4" />

            <!-- Drone View Row -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="DRONE VIEW (CAMERA ZOOM)"
                android:textColor="#00E5FF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnMainDrone2x"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="#1E232E"
                    android:text="2X"
                    android:textColor="#ECEFF4"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnMainDrone3x"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="#1E232E"
                    android:text="3X"
                    android:textColor="#ECEFF4"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnMainDrone4x"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="#1E232E"
                    android:text="4X"
                    android:textColor="#ECEFF4"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnMainDrone5x"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="#1E232E"
                    android:text="5X"
                    android:textColor="#ECEFF4"
                    android:textStyle="bold" />
            </LinearLayout>

            <Button
                android:id="@+id/btnMainDroneReset"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="6dp"
                android:background="#2E3440"
                android:text="RESTORE STOCK CAMERA"
                android:textColor="#D8DEE9"
                android:textSize="11sp" />

            <!-- 7 Hero Skins Row -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="UNLOCK HERO SKINS (7 HEROES)"
                android:textColor="#FFD54F"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Fanny (Mikasa) • Gusion (KOF) • Ling (Shen) • Nolan • Miya • Claude • Karrie"
                android:textColor="#81A1C1"
                android:textSize="10sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnMainUnlockAllSkins"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="#1E3324"
                    android:text="★ UNLOCK ALL 7 SKINS"
                    android:textColor="#00E676"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnMainRestoreAllSkins"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="#331E1E"
                    android:text="RESTORE ALL SKINS"
                    android:textColor="#FF5252"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Map & Skins Row -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="MAP ASSETS &amp; SKINS"
                android:textColor="#00E5FF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnMainMapSkins"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="#1E232E"
                    android:text="INJECT MAP + SKINS"
                    android:textColor="#FFD54F"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnMainRestoreMap"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="#1E232E"
                    android:text="RESTORE MAP"
                    android:textColor="#D8DEE9"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/txtShizukuLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="#0B0D10"
                android:fontFamily="monospace"
                android:padding="8dp"
                android:text="Ready."
                android:textColor="#8FBCBB"
                android:textIsSelectable="true"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Footer Info -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="v3.2 • 16KB Page Aligned • C++17 ImGui Engine"
            android:textColor="#6C7280"
            android:textSize="11sp" />

    </LinearLayout>
</ScrollView>