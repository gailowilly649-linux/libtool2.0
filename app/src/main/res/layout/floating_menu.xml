                android:layout_height="28dp"
                android:layout_marginTop="3dp"
                android:background="#2E3440"
                android:text="RESTORE STOCK CAMERA"
                android:textColor="#D8DEE9"
                android:textSize="9sp" />

            <!-- 2. REAL 165 FPS AND FAKE SPOOF SECTION -->
