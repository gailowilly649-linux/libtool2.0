                    android:layout_height="32dp"
                    android:layout_marginStart="3dp"
                    android:layout_weight="1"
                    android:background="#1E232E"
                    android:text="5X"
                    android:textColor="#ECEFF4"
                    android:textSize="10sp"
                    android:textStyle="bold" />
