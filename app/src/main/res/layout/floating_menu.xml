<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/floatingRoot"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:background="#F012151C"
    android:orientation="vertical"
    android:padding="10dp">

    <!-- Header / Drag Bar -->
    <LinearLayout
        android:id="@+id/floatingHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="6dp">

        <View
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="#00E5FF" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="WILLY LIBTOOL (NO ROOT)"
            android:textColor="#ECEFF4"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnFloatingMinimize"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="#2E3440"
            android:text="—"
            android:textColor="#D8DEE9"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnFloatingStealth"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="4dp"
            android:background="#2E3440"
            android:text="👁"
            android:textColor="#00E5FF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnFloatingClose"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="4dp"
            android:background="#D5011D"
            android:text="✕"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#2E3440" />

    <!-- Scrollable content area so it never overflows in MLBB landscape -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="230dp"
        android:fillViewport="true"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <!-- 1. DRONE VIEW SECTION -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="DRONE VIEW (CAMERA ZOOM)"
                android:textColor="#00E5FF"
                android:textSize="10sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnDrone2x"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_weight="1"
                    android:background="#1E232E"
                    android:text="2X"
                    android:textColor="#ECEFF4"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnDrone3x"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="3dp"
                    android:layout_weight="1"
                    android:background="#1E232E"
                    android:text="3X"
                    android:textColor="#ECEFF4"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnDrone4x"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="3dp"
                    android:layout_weight="1"
                    android:background="#1E232E"
                    android:text="4X"
                    android:textColor="#ECEFF4"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnDrone5x"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="3dp"
                    android:layout_weight="1"
                    android:background="#1E232E"
                    android:text="5X"
                    android:textColor="#ECEFF4"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <Button
                android:id="@+id/btnDroneReset"
                android:layout_width="match_parent"
                android:layout_height="28dp"
                android:layout_marginTop="3dp"
                android:background="#2E3440"
                android:text="RESTORE STOCK CAMERA"
                android:textColor="#D8DEE9"
                android:textSize="9sp" />

            <!-- 2. REAL 165 FPS & FAKE SPOOF SECTION -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="⚡ ULTRA 165 FPS (FAKE SPOOF)"
                    android:textColor="#00E5FF"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvFpsStatusBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#2E3440"
                    android:paddingStart="4dp"
                    android:paddingTop="1dp"
                    android:paddingEnd="4dp"
                    android:paddingBottom="1dp"
                    android:text="ROG 8 PRO"
                    android:textColor="#76FF03"
                    android:textSize="7sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="Uncaps 165 FPS in engine + ASUS ROG 8 Pro spoof + 144Hz panel sync"
                android:textColor="#90A4AE"
                android:textSize="8sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnUnlock165Fps"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_weight="1.2"
                    android:background="#1E232E"
                    android:text="⚡ UNLOCK 165 FPS"
                    android:textColor="#00E676"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnResetFps"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="3dp"
                    android:layout_weight="0.8"
                    android:background="#2E3440"
                    android:text="RESET 60 HZ"
                    android:textColor="#D8DEE9"
                    android:textSize="9sp" />
            </LinearLayout>

            <!-- 3. UNLOCK HERO SKINS SECTION (12 HEROES) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="UNLOCK HERO SKINS (12 HEROES)"
                android:textColor="#FFD54F"
                android:textSize="10sp"
                android:textStyle="bold" />

            <!-- Quick Action: All 12 Heroes -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnUnlockAllSkins"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:background="#1E3324"
                    android:text="★ UNLOCK ALL 12"
                    android:textColor="#00E676"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnRestoreAllSkins"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:background="#331E1E"
                    android:text="RESTORE ALL"
                    android:textColor="#FF5252"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Assassins: Fanny, Gusion, Ling, Nolan -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Assassins (Fanny • Gusion • Ling • Nolan)"
                android:textColor="#81A1C1"
                android:textSize="9sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnSkinFanny"
                    android:layout_width="0dp"
                    android:layout_height="30dp"
                    android:layout_weight="1"
                    android:background="#1E232E"
                    android:text="FANNY (MIKASA)"
                    android:textColor="#ECEFF4"
                    android:textSize="8sp" />

                <Button
                    android:id="@+id/btnSkinGusion"
                    android:layout_width="0dp"
                    android:layout_height="30dp"
                    android:layout_marginStart="3dp"
                    android:layout_weight="1"
                    android:background="#1E232E"
                    android:text="GUSION (KOF)"
                    android:textColor="#ECEFF4"
                    android:textSize="8sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnSkinLing"
                    android:layout_width="0dp"
                    android:layout_height="30dp"
                    android:layout_weight="1"
                    android:background="#1E232E"
                    android:text="LING (SHEN)"
                    android:textColor="#ECEFF4"
                    android:textSize="8sp" />

                <Button
                    android:id="@+id/btnSkinNolan"
                    android:layout_width="0dp"
                    android:layout_height="30dp"
                    android:layout_marginStart="3dp"
                    android:layout_weight="1"
                    android:background="#1E232E"
                    android:text="NOLAN (NAV)"
                    android:textColor="#ECEFF4"
                    android:textSize="8sp" />
            </LinearLayout>

            <!-- Marksmen: Miya, Claude, Karrie -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Marksmen (Miya • Claude • Karrie)"
                android:textColor="#81A1C1"
                android:textSize="9sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnSkinMiya"
                    android:layout_width="0dp"
                    android:layout_height="30dp"
                    android:layout_weight="1"
                    android:background="#1E232E"
                    android:text="MIYA (COLL)"
                    android:textColor="#ECEFF4"
                    android:textSize="8sp" />

                <Button
                    android:id="@+id/btnSkinClaude"
                    android:layout_width="0dp"
                    android:layout_height="30dp"
                    android:layout_marginStart="3dp"
                    android:layout_weight="1"
                    android:background="#1E232E"
                    android:text="CLAUDE (SANRIO)"
                    android:textColor="#ECEFF4"
                    android:textSize="8sp" />

                <Button
                    android:id="@+id/btnSkinKarrie"
                    android:layout_width="0dp"
                    android:layout_height="30dp"
                    android:layout_marginStart="3dp"
                    android:layout_weight="1"
                    android:background="#1E232E"
                    android:text="KARRIE (M5)"
                    android:textColor="#ECEFF4"
                    android:textSize="8sp" />
            </LinearLayout>

            <!-- 4. MAP & BATTLE ASSETS -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="MAP &amp; BATTLE ASSETS"
                android:textColor="#00E5FF"
                android:textSize="10sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnInjectMapSkins"
                    android:layout_width="0dp"
                    android:layout_height="30dp"
                    android:layout_weight="1"
                    android:background="#1E232E"
                    android:text="MAP MODS"
                    android:textColor="#FFD54F"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnRestoreMapSkins"
                    android:layout_width="0dp"
                    android:layout_height="30dp"
                    android:layout_marginStart="3dp"
                    android:layout_weight="1"
                    android:background="#1E232E"
                    android:text="RESTORE MAP"
                    android:textColor="#D8DEE9"
                    android:textSize="9sp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Status message -->
    <TextView
        android:id="@+id/txtFloatingStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="#0B0D10"
        android:fontFamily="monospace"
        android:padding="6dp"
        android:text="Ready."
        android:textColor="#8FBCBB"
        android:textSize="10sp" />

</LinearLayout>
