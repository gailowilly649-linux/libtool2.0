<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/floatingRoot"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:background="#F012151C"
    android:orientation="vertical"
    android:padding="10dp">

    <!-- Header / Drag Bar -->
    <LinearLayout
        android:id="@+id/floatingHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="6dp">

        <View
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="#00E5FF" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="WILLY LIBTOOL v3.4 (NO ROOT)"
            android:textColor="#ECEFF4"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnFloatingMinimize"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="#2E3440"
            android:text="—"
            android:textColor="#D8DEE9"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnFloatingStealth"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="4dp"
            android:background="#2E3440"
            android:text="👁"
            android:textColor="#00E5FF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnFloatingClose"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="4dp"
            android:background="#D5011D"
            android:text="✕"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#2E3440" />

    <!-- Scrollable content area so it never overflows in MLBB landscape -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="230dp"
        android:fillViewport="true"
        android:scrollbars="vertical">

        <LinearLayout
